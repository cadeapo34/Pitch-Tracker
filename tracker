function buildSummary(){
 const ps=[];st.b.forEach((a,ai)=>a.forEach(p=>ps.push(Object.assign({},p,{bt:st.bat[ai]}))));
 const who=a=>{const m={};a.forEach(p=>m[p.bt]=(m[p.bt]||0)+1);const r=Object.keys(m).map(k=>lab(+k)+' ('+m[k]+')').join(', ');return r||'—'};
 const bats=(arr,f)=>arr.filter(f).map(x=>lab(st.bat[st.b.indexOf(x.a)])).join(', ');
 const pct=(a,b)=>b?Math.round(a/b*100):0,pl=(n,w)=>n+' '+w+(n===1?'':'s'),pp=n=>pl(n,'pitch').replace('pitchs','pitches');
 const c=(a,r)=>a.filter(p=>r.includes(p.r)).length;
 const stat=a=>({n:a.length,S:c(a,'S'),T:c(a,'T'),F:c(a,'F'),b:c(a,'B'),ip:c(a,'XHN'),h:c(a,'H'),f:a.filter(p=>p.f).length,ld:a.filter(p=>p.h==='L'&&(p.r==='H'||p.r==='X')).length});
 const score=t=>pct(t.S+t.T+.5*t.F,t.n);
 const grp=kf=>{const m={};ps.forEach(p=>{const k=kf(p);if(k==null||k==='')return;(m[k]=m[k]||[]).push(p)});return m};
 const good=[],bad=[],T=stat(ps);
 const mix=t=>[t.S?pl(t.S,'swinging strike'):'',t.T?pl(t.T,'take'):'',t.F?pl(t.F,'foul'):'',t.b?pl(t.b,'ball'):'',t.ip?t.ip+' in play':''].filter(Boolean).join(', ');
 const judge=(lab,a)=>{if(a.length<3)return;const t=stat(a),sc=score(t),head=lab+': '+pp(t.n)+' ('+mix(t)+')';
  const bd=[];if(t.b/t.n>=.5)bd.push(head+' — over half were balls. Balls to: '+who(a.filter(p=>p.r==='B'))+'.');
  if(t.h>=1&&t.h/t.n>=.2)bd.push(lab+': '+pl(t.h,'hit')+' allowed on '+pp(t.n)+'. Hits by: '+who(a.filter(p=>p.r==='H'))+'.');
  if(!bd.length&&(t.b+t.ip)/t.n>=.65)bd.push(head+' — few swinging strikes or takes. Poor outcomes vs: '+who(a.filter(p=>'BXHN'.includes(p.r)))+'.');
  if(bd.length)bad.push(...bd);else if(sc>=45&&t.h===0)good.push(head+(t.f?', '+t.f+' fooled':'')+'; no hits allowed. Swinging strikes/takes vs: '+who(a.filter(p=>p.r==='S'||p.r==='T'))+'.')};
 const tg=grp(p=>p.t);Object.keys(tg).forEach(k=>judge(nm(+k),tg[k]));
 const Z={1:'low left',2:'low right',3:'high left',4:'high right'};
 const zg=grp(p=>p.z);Object.keys(zg).forEach(k=>judge('Zone '+k+' ('+Z[k]+', catcher\'s view)',zg[k]));
 const ends=st.b.map(a=>({a,t:tally(a)})).filter(x=>x.t.end);
 const K=ends.filter(x=>x.t.end==='Strikeout').length,BB=ends.filter(x=>x.t.end==='Walk').length,H=ends.filter(x=>x.a[x.a.length-1].r==='H').length;
 const fl=Object.keys(tg).map(k=>[k,tg[k].filter(p=>p.f).length]).filter(x=>x[1]);
 if(T.f)good.push('Batters were fooled on '+pp(T.f)+(fl.length?' ('+fl.map(x=>nm(+x[0])+' '+x[1]).join(', ')+')':'')+'. Batters: '+who(ps.filter(p=>p.f))+'.');
 if(K)good.push(pl(K,'strikeout')+': '+bats(ends,x=>x.t.end==='Strikeout')+'.');
 const fp=st.b.filter(a=>a.length).map(a=>a[0]);
 if(fp.length>=2){const g=fp.filter(p=>p.r==='S'||p.r==='T').length,fo=fp.filter(p=>p.r==='F').length,sc=pct(g+.5*fo,fp.length),txt='First pitch: '+g+' swinging strike/take'+(g===1?'':'s')+(fo?' plus '+pl(fo,'foul'):'')+' of '+fp.length+'.';
  if(sc>=55)good.push(txt);else if(sc<40)bad.push(txt)}
 const HB=ends.filter(x=>x.t.end==='HBP').length;if(HB)bad.push(HB+' hit by pitch: '+bats(ends,x=>x.t.end==='HBP')+'.');
 if(BB)bad.push(pl(BB,'walk')+': '+bats(ends,x=>x.t.end==='Walk')+'.');
 if(T.h)bad.push(pl(T.h,'hit')+' allowed. Hits by: '+who(ps.filter(p=>p.r==='H'))+'.');
 if(T.ld>=2)bad.push(pl(T.ld,'line drive')+' allowed. Hit by: '+who(ps.filter(p=>p.h==='L'&&(p.r==='H'||p.r==='X')))+'.');
 const none='Nothing stands out yet (a pitch type or zone needs at least 3 pitches).';
 const secs=[{t:'Overview',c:'#2c6fbb',items:['Through '+pl(ends.length,'completed at-bat')+', '+pp(ps.length)+'.','Outcomes: '+(mix(T)||'none yet')+'.','Hits '+H+'-for-'+ends.filter(x=>x.t.end!=='Walk'&&x.t.end!=='HBP').length+' at-bats.','Ranking used: swinging strike and take are best, a foul is next, then a ball, a ball in play or a hit.']},
  {t:'What has worked',c:'#1f7a3f',items:good.length?good:[none]},{t:'What has not worked',c:'#c0392b',items:bad.length?bad:[none]}];
 if(st.pit.length>1){const pg=grp(p=>p.pi||1);secs.push({t:'By pitcher',c:'#8e44ad',items:Object.keys(pg).map(k=>{const t=stat(pg[k]);return plab(+k)+': '+pp(t.n)+' ('+mix(t)+'), '+pl(t.h,'hit')+' allowed.'})})}
 secs.push({t:'At-bats',c:'#74726b',items:ends.map(x=>{const i=st.b.indexOf(x.a),l=x.a[x.a.length-1];return 'At-bat '+(i+1)+' · '+bl(i)+': '+(x.t.end==='Strikeout'?'Strikeout':x.t.end==='Walk'?'Walk':x.t.end==='HBP'?'Hit by pitch':l.r==='H'?'Hit':l.r==='N'?'Bunt':'Out in play')+' ('+pp(x.a.length)+')'})});
 return secs}
